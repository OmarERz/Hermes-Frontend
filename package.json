{
  "name": "hermes-front",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "bash e2e/run.sh",
    "e2e:check": "tsc -p e2e/tsconfig.json",
    "design:capture": "E2E_DESIGN=1 bash e2e/run.sh --project=design",
    "lint": "eslint . && npm run lint:tokens",
    "lint:tokens": "node scripts/check-tokens.mjs --self-test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/app/core/api/schema.d.ts",
    "api:check": "openapi-typescript openapi/openapi.json -o src/app/core/api/schema.d.ts --check",
    "verify": "npm run api:check && npm run lint && npm run format:check && npm run e2e:check && npm run test:coverage && npm run build",
    "audit": "npm audit --omit=dev --audit-level=high",
    "semgrep": "bash scripts/semgrep.sh",
    "zap": "bash scripts/zap.sh"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/inter": "5.3.0",
    "@lucide/angular": "^1.73.0",
    "echarts": "^6.1.0",
    "firebase": "^12.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "21.4.0",
    "eslint": "9.39.5",
    "jsdom": "^28.0.0",
    "openapi-typescript": "7.9.1",
    "prettier": "3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
