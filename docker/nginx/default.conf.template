# Server of the front image (Dockerfile). The image entrypoint renders this template with envsubst at start, into
# /tmp/conf.d: API_UPSTREAM, CSP_CONNECT_EXTRA and HSTS_INCLUDE_SUBDOMAINS come from the environment (defaults in the
# Dockerfile) and NGINX_LOCAL_RESOLVERS from /etc/resolv.conf (Docker's DNS), so the API host is resolved per request
# and the front starts even when the backend is not up yet.

# Content-Security-Policy: scripts only from this origin (no inline scripts: the build inlines no critical CSS loader
# and index.html has no inline script). Styles: the stylesheets of this origin plus the <style> elements Angular injects
# at run time, which carry this request's nonce ($request_id, 16 random bytes): nginx writes it into the ngCspNonce
# attribute of index.html (sub_filter below) and Angular copies it to each <style>; no inline <style> element runs
# without it (style-src-elem). Only style *attributes* stay allowed (style-src-attr 'unsafe-inline'): the tooltips of
# ECharts are HTML with style attributes, and an attribute styles its own element only (no selectors, no imports).
# Fonts are self-hosted (@fontsource). connect-src: this origin (the API behind /api/) and Firebase Auth; CSP_CONNECT_EXTRA adds
# origins such as the Auth emulator of the e2e suite.
# The map has a constant key: it only names the policy for the included header file and never reads the request.
map "" $hermes_csp {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-$request_id'; style-src-elem 'self' 'nonce-$request_id'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com ${CSP_CONNECT_EXTRA}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
}

# HSTS like the backend: one year, includeSubDomains only when HSTS_INCLUDE_SUBDOMAINS=true. Browsers honour it only
# over HTTPS (behind the TLS proxy of the deployment).
map "${HSTS_INCLUDE_SUBDOMAINS}" $hermes_hsts {
    true    "max-age=31536000; includeSubDomains";
    default "max-age=31536000";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The API on the same origin: proxied to the backend api service, so the browser needs no CORS. The backend sets
    # its own security headers on these answers; none of the front's are added here. `^~`: the regular expressions
    # below are never tried for /api/, so an id with a dot (GET /api/assets/host.example) still reaches the API.
    location ^~ /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
        set $hermes_api "${API_UPSTREAM}";
        proxy_pass $hermes_api;
        proxy_http_version 1.1;
        # The upstream's own host name (nginx's default), never the client's Host header: the API does not use it.
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The run progress (GET /api/runs/{id}/events) is a server-sent event stream: no buffering, long reads.
        proxy_buffering off;
        proxy_read_timeout 1h;
        client_max_body_size 2m;
    }

    # Mounted at run time (compose.yaml), never baked into the image; absent, the app uses its build defaults.
    location = /runtime-config.json {
        include /etc/nginx/hermes/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # The app's page (also every route of the app: the fallback below redirects here internally). It carries this
    # request's CSP nonce, so it is never stored or reused (no-store), and no validator survives sub_filter.
    location = /index.html {
        include /etc/nginx/hermes/security-headers.conf;
        add_header Cache-Control "no-store" always;
        # Every copy: the build also writes the placeholder as the nonce of its entry script (script-src stays 'self').
        sub_filter_once off;
        sub_filter 'HERMES_CSP_NONCE' '$request_id';
    }

    # Files with a content hash in the name (outputHashing: all: the bundles at the root and the fonts in media/) never
    # change: public, cached for a year.
    location ~ "^/(media/)?[A-Za-z0-9._-]+-[A-Z0-9]{8}\.(js|css|woff2?)$" {
        include /etc/nginx/hermes/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The other files of the build (no hash in the name: favicon, images in assets/) are revalidated on every use
    # (no-cache), so a new release shows at once. A missing one (at the root, or under assets/ or media/) is a 404, not
    # the app; other paths with a dot are routes of the app (/activos/host.example) and go to the fallback.
    location ~ "^/((assets|media)/.+|[^/]+)\.[A-Za-z0-9]+$" {
        include /etc/nginx/hermes/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Every other path is a route of the app (single-page fallback to /index.html above).
    location / {
        include /etc/nginx/hermes/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri /index.html;
    }
}
